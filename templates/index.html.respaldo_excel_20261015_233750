<!DOCTYPE html>
<html lang="es">

<head>

    <meta charset="UTF-8">

    <meta
        name="viewport"
        content="width=device-width, initial-scale=1.0"
    >

    <title>Agua Potable Lab</title>

    <link
        rel="stylesheet"
        href="/static/style.css"
    >

</head>


<body>


<header class="encabezado">

    <div>

        <h1>Agua Potable Lab</h1>

        <p>
            Sistema de registro y control del proceso
        </p>

        <p>
    Operador activo:
    <strong id="operador-sesion-nombre"></strong>
</p>

<button
    type="button"
    class="btn-secundario"
    onclick="cerrarSesionOperador()"
>
    Cerrar sesión
</button>

    </div>

</header>



<main class="contenedor">


    <!-- INICIO DE OPERACIÓN -->

    <section class="panel">

        <h2>Inicio de operación</h2>

        <label for="operador">
            Operador responsable
        </label>


        <div class="fila">

            <select id="operador">

                <option value="">
                    Seleccione un operador
                </option>

            </select>


            <button
                class="btn-secundario"
                onclick="abrirRegistroOperador()"
            >
                + Nuevo operador
            </button>

        </div>


        <div
            id="mensaje-operador"
            class="mensaje"
        ></div>

    </section>



    <!-- CREAR LOTE -->

    <section class="panel">

        <h2>Producción</h2>

        <p class="texto-ayuda">

            Seleccione el operador responsable
            y cree un nuevo lote para comenzar.

        </p>


        <button
            id="btn-lote"
            class="btn-principal"
            onclick="crearLote()"
        >

            INICIAR NUEVO LOTE

        </button>


        <div
            id="lote-creado"
            class="lote"
        ></div>

    </section>



    <!-- MENÚ PRINCIPAL -->

    <section
        class="panel oculto"
        id="menu-operacion"
    >

        <h2>Registro del proceso</h2>


        <div class="grid">


            <button
                class="boton-menu"
                onclick="abrirControlTratamiento()"
            >

                💧 Control del agua

            </button>


            <button
                class="boton-menu"
                onclick="abrirControlTanque()"
>
                 🛢️ Control del tanque
            </button>


            <button
                class="boton-menu"
                onclick="abrirControlUV()"
>
                ☀️ Control UV
            </button>


            <button
                class="boton-menu"
                onclick="abrirPreparacionGarrafones()"
>
                🧴 Preparación de envases
            </button>


            <button
                class="boton-menu"
                onclick="abrirRegistroLlenado()"
>
                🚰 Registro de llenado
            </button>


            <button
                class="boton-menu"
                onclick="abrirControlCalidad()"
>
                🧪 Control de calidad
            </button>


            <button
                class="boton-menu"
                onclick="abrirLimpiezaDesinfeccion()"
            >
                🧹 Limpieza
            </button>


            <button
                class="boton-menu"
                onclick="abrirMantenimiento()"
>

                🔧 Mantenimiento

            </button>


        </div>

    </section>



    <!-- CONTROL DEL TRATAMIENTO -->

    <section
        class="panel oculto"
        id="panel-tratamiento"
    >


        <div class="cabecera-modulo">


            <div>

                <h2>
                    Control del tratamiento del agua
                </h2>

                <p
                    id="informacion-lote"
                    class="texto-ayuda"
                ></p>

            </div>


            <button
                class="btn-secundario"
                onclick="cerrarControlTratamiento()"
            >

                Volver

            </button>


        </div>



        <!-- SEDIMENTOS -->

        <div class="control-item">

            <h3>
                Filtro de sedimentos
            </h3>


            <div class="estado-botones">

                <button
                    class="estado-btn"
                    id="sedimentos-conforme"
                    onclick="
                        seleccionarEstado(
                            'sedimentos',
                            'Conforme'
                        )
                    "
                >

                    ✓ Conforme

                </button>


                <button
                    class="estado-btn"
                    id="sedimentos-no-conforme"
                    onclick="
                        seleccionarEstado(
                            'sedimentos',
                            'No conforme'
                        )
                    "
                >

                    ✕ No conforme

                </button>

            </div>

        </div>



        <!-- CARBÓN -->

        <div class="control-item">

            <h3>
                Carbón activado
            </h3>


            <div class="estado-botones">

                <button
                    class="estado-btn"
                    id="carbon_activado-conforme"
                    onclick="
                        seleccionarEstado(
                            'carbon_activado',
                            'Conforme'
                        )
                    "
                >

                    ✓ Conforme

                </button>


                <button
                    class="estado-btn"
                    id="carbon_activado-no-conforme"
                    onclick="
                        seleccionarEstado(
                            'carbon_activado',
                            'No conforme'
                        )
                    "
                >

                    ✕ No conforme

                </button>

            </div>

        </div>



        <!-- RESINA -->

        <div class="control-item">

            <h3>
                Resina catiónica SAC
            </h3>


            <div class="estado-botones">

                <button
                    class="estado-btn"
                    id="resina_sac-conforme"
                    onclick="
                        seleccionarEstado(
                            'resina_sac',
                            'Conforme'
                        )
                    "
                >

                    ✓ Conforme

                </button>


                <button
                    class="estado-btn"
                    id="resina_sac-no-conforme"
                    onclick="
                        seleccionarEstado(
                            'resina_sac',
                            'No conforme'
                        )
                    "
                >

                    ✕ No conforme

                </button>

            </div>

        </div>



        <!-- ÓSMOSIS -->

        <div class="control-item">

            <h3>
                Ósmosis inversa
            </h3>


            <div class="estado-botones">

                <button
                    class="estado-btn"
                    id="osmosis_inversa-conforme"
                    onclick="
                        seleccionarEstado(
                            'osmosis_inversa',
                            'Conforme'
                        )
                    "
                >

                    ✓ Conforme

                </button>


                <button
                    class="estado-btn"
                    id="osmosis_inversa-no-conforme"
                    onclick="
                        seleccionarEstado(
                            'osmosis_inversa',
                            'No conforme'
                        )
                    "
                >

                    ✕ No conforme

                </button>

            </div>

        </div>



        <!-- BOMBA -->

        <div class="control-item">

            <h3>
                Bomba
            </h3>


            <div class="estado-botones">

                <button
                    class="estado-btn"
                    id="bomba-conforme"
                    onclick="
                        seleccionarEstado(
                            'bomba',
                            'Conforme'
                        )
                    "
                >

                    ✓ Conforme

                </button>


                <button
                    class="estado-btn"
                    id="bomba-no-conforme"
                    onclick="
                        seleccionarEstado(
                            'bomba',
                            'No conforme'
                        )
                    "
                >

                    ✕ No conforme

                </button>

            </div>

        </div>



        <!-- OBSERVACIONES -->

        <div class="control-item">

            <h3>
                Observaciones
            </h3>


            <textarea
                id="observaciones-tratamiento"
                rows="4"
                placeholder="Escriba aquí alguna observación..."
            ></textarea>

        </div>



        <!-- RESULTADO -->

        <div
            id="resultado-tratamiento"
            class="resultado-tratamiento"
        >

            Seleccione el estado de todas las etapas.

        </div>



        <!-- GUARDAR -->

        <button
            class="btn-principal btn-guardar"
            onclick="guardarControlTratamiento()"
        >

            GUARDAR CONTROL

        </button>


    </section>

    <!-- =====================================================
     CONTROL DEL TANQUE
     ===================================================== -->

<section
    class="panel oculto"
    id="panel-tanque"
>


    <div class="cabecera-modulo">

        <div>

            <h2>
                Control del tanque de almacenamiento
            </h2>

            <p
                id="informacion-lote-tanque"
                class="texto-ayuda"
            ></p>

        </div>


        <button
            class="btn-secundario"
            onclick="cerrarControlTanque()"
        >

            Volver

        </button>

    </div>


    <!-- ESTADO INICIAL -->

    <div class="control-item">

        <h3>
            Estado inicial del tanque
        </h3>


        <div class="estado-botones tanque-botones">

            <button
                class="estado-btn"
                id="tanque-inicial-vacio"
                onclick="seleccionarNivelTanque('inicial', 'Vacío')"
            >
                Vacío
            </button>


            <button
                class="estado-btn"
                id="tanque-inicial-bajo"
                onclick="seleccionarNivelTanque('inicial', 'Bajo')"
            >
                Bajo
            </button>


            <button
                class="estado-btn"
                id="tanque-inicial-medio"
                onclick="seleccionarNivelTanque('inicial', 'Medio')"
            >
                Medio
            </button>


            <button
                class="estado-btn"
                id="tanque-inicial-alto"
                onclick="seleccionarNivelTanque('inicial', 'Alto')"
            >
                Alto
            </button>


            <button
                class="estado-btn"
                id="tanque-inicial-lleno"
                onclick="seleccionarNivelTanque('inicial', 'Lleno')"
            >
                Lleno
            </button>

        </div>

    </div>



    <!-- ESTADO FINAL -->

    <div class="control-item">

        <h3>
            Estado final del tanque
        </h3>


        <div class="estado-botones tanque-botones">

            <button
                class="estado-btn"
                id="tanque-final-vacio"
                onclick="seleccionarNivelTanque('final', 'Vacío')"
            >
                Vacío
            </button>


            <button
                class="estado-btn"
                id="tanque-final-bajo"
                onclick="seleccionarNivelTanque('final', 'Bajo')"
            >
                Bajo
            </button>


            <button
                class="estado-btn"
                id="tanque-final-medio"
                onclick="seleccionarNivelTanque('final', 'Medio')"
            >
                Medio
            </button>


            <button
                class="estado-btn"
                id="tanque-final-alto"
                onclick="seleccionarNivelTanque('final', 'Alto')"
            >
                Alto
            </button>


            <button
                class="estado-btn"
                id="tanque-final-lleno"
                onclick="seleccionarNivelTanque('final', 'Lleno')"
            >
                Lleno
            </button>

        </div>

    </div>



    <!-- HORARIOS -->

    <div class="control-item">

        <h3>
            Registro del llenado del tanque
        </h3>


        <div class="horas-tanque">


            <div class="hora-bloque">

                <strong>
                    Hora de inicio
                </strong>

                <div
                    id="hora-inicio-tanque"
                    class="hora-registrada"
                >
                    No registrada
                </div>


                <button
                    class="btn-secundario"
                    onclick="registrarHoraInicioTanque()"
                >

                    Registrar inicio

                </button>

            </div>



            <div class="hora-bloque">

                <strong>
                    Hora final
                </strong>

                <div
                    id="hora-final-tanque"
                    class="hora-registrada"
                >
                    No registrada
                </div>


                <button
                    class="btn-secundario"
                    onclick="registrarHoraFinalTanque()"
                >

                    Registrar final

                </button>

            </div>


        </div>

    </div>



    <!-- LIMPIEZA -->

    <div class="control-item">

        <h3>
            Limpieza del tanque
        </h3>


        <div class="estado-botones">

            <button
                class="estado-btn"
                id="limpieza-si"
                onclick="seleccionarLimpiezaTanque('Sí')"
            >

                ✓ Sí, verificada

            </button>


            <button
                class="estado-btn"
                id="limpieza-no"
                onclick="seleccionarLimpiezaTanque('No')"
            >

                ✕ No verificada

            </button>

        </div>

    </div>



    <!-- TAPA -->

    <div class="control-item">

        <h3>
            Condición de la tapa
        </h3>


        <div class="estado-botones">

            <button
                class="estado-btn"
                id="tapa-correcta"
                onclick="seleccionarTapaTanque('Correcta')"
            >

                ✓ Correcta

            </button>


            <button
                class="estado-btn"
                id="tapa-incorrecta"
                onclick="seleccionarTapaTanque('Incorrecta')"
            >

                ✕ Incorrecta

            </button>

        </div>

    </div>



    <!-- CONDICIÓN GENERAL -->

    <div class="control-item">

        <h3>
            Condición general
        </h3>


        <div class="estado-botones">

            <button
                class="estado-btn"
                id="tanque-conforme"
                onclick="seleccionarCondicionTanque('Conforme')"
            >

                ✓ Conforme

            </button>


            <button
                class="estado-btn"
                id="tanque-no-conforme"
                onclick="seleccionarCondicionTanque('No conforme')"
            >

                ✕ No conforme

            </button>

        </div>

    </div>



    <!-- OBSERVACIONES -->

    <div class="control-item">

        <h3>
            Observaciones
        </h3>


        <textarea
            id="observaciones-tanque"
            rows="4"
            placeholder="Escriba aquí alguna observación..."
        ></textarea>

    </div>



    <!-- GUARDAR -->

    <button
        class="btn-principal btn-guardar"
        onclick="guardarControlTanque()"
    >

        GUARDAR CONTROL DEL TANQUE

    </button>


</section>

<!-- =====================================================
     CONTROL UV
     ===================================================== -->

<section
    class="panel oculto"
    id="panel-uv"
>

    <div class="cabecera-modulo">

        <div>

            <h2>
                Control de desinfección UV
            </h2>

            <p
                id="informacion-lote-uv"
                class="texto-ayuda"
            ></p>

        </div>

        <button
            class="btn-secundario"
            onclick="cerrarControlUV()"
        >
            Volver
        </button>

    </div>


    <!-- ESTADO DE LA UV -->

    <div class="control-item">

        <h3>
            Estado de la unidad UV
        </h3>

        <div class="estado-botones">

            <button
                class="estado-btn"
                id="uv-encendida-si"
                onclick="seleccionarUVEncendida('Sí')"
            >
                ✓ Encendida
            </button>

            <button
                class="estado-btn"
                id="uv-encendida-no"
                onclick="seleccionarUVEncendida('No')"
            >
                ✕ No encendida
            </button>

        </div>

    </div>


    <!-- INDICADOR -->

    <div class="control-item">

        <h3>
            Indicador de funcionamiento
        </h3>

        <div class="estado-botones">

            <button
                class="estado-btn"
                id="uv-indicador-normal"
                onclick="seleccionarIndicadorUV('Normal')"
            >
                ✓ Normal
            </button>

            <button
                class="estado-btn"
                id="uv-indicador-alarma"
                onclick="seleccionarIndicadorUV('Alarma')"
            >
                ✕ Alarma
            </button>

        </div>

    </div>


    <!-- LÁMPARA -->

    <div class="control-item">

        <h3>
            Estado de la lámpara
        </h3>

        <div class="estado-botones">

            <button
                class="estado-btn"
                id="uv-lampara-conforme"
                onclick="seleccionarLamparaUV('Conforme')"
            >
                ✓ Conforme
            </button>

            <button
                class="estado-btn"
                id="uv-lampara-revision"
                onclick="seleccionarLamparaUV('Requiere revisión')"
            >
                ✕ Requiere revisión
            </button>

        </div>

    </div>


    <!-- CAMISA -->

    <div class="control-item">

        <h3>
            Estado de la camisa de cuarzo
        </h3>

        <div class="estado-botones">

            <button
                class="estado-btn"
                id="uv-camisa-conforme"
                onclick="seleccionarCamisaUV('Conforme')"
            >
                ✓ Conforme
            </button>

            <button
                class="estado-btn"
                id="uv-camisa-limpieza"
                onclick="seleccionarCamisaUV('Requiere limpieza')"
            >
                ✕ Requiere limpieza
            </button>

        </div>

    </div>


    <!-- OBSERVACIONES -->

    <div class="control-item">

        <h3>
            Observaciones
        </h3>

        <textarea
            id="observaciones-uv"
            rows="4"
            placeholder="Escriba aquí alguna observación..."
        ></textarea>

    </div>


    <!-- GUARDAR -->

    <button
        class="btn-principal btn-guardar"
        onclick="guardarControlUV()"
    >
        GUARDAR CONTROL UV
    </button>

</section>

<!-- =====================================================
     PREPARACIÓN DE GARRAFONES
     ===================================================== -->

<section
    class="panel oculto"
    id="panel-garrafones"
>

    <div class="cabecera-modulo">

        <div>

            <h2>
                Preparación y desinfección de garrafones
            </h2>

            <p
                id="informacion-lote-garrafones"
                class="texto-ayuda"
            ></p>

        </div>

        <button
            class="btn-secundario"
            onclick="cerrarPreparacionGarrafones()"
        >
            Volver
        </button>

    </div>


    <!-- CANTIDAD -->

    <div class="control-item">

        <h3>
            Cantidad de garrafones
        </h3>

        <div class="contador-garrafones">

            <button
                class="contador-btn"
                onclick="cambiarCantidadGarrafones(-1)"
            >
                −
            </button>

            <div
                id="cantidad-garrafones"
                class="cantidad-valor"
            >
                1
            </div>

            <button
                class="contador-btn"
                onclick="cambiarCantidadGarrafones(1)"
            >
                +
            </button>

        </div>

    </div>


    <!-- DESINFECTANTE -->

    <div class="control-item">

        <h3>
            Desinfección del garrafón
        </h3>

        <div class="informacion-procedimiento">

            <strong>
                Dióxido de dicloro
            </strong>

            <p>
                Dosis establecida:
                <strong>2 gotas por garrafón</strong>
            </p>

            <p>
                El procedimiento comprende:
                aplicación del desinfectante,
                primer lavado y enjuague,
                desecho del agua,
                segundo enjuague y
                desecho del agua antes del llenado.
            </p>

        </div>

    </div>


    <!-- PRIMER ENJUAGUE -->

    <div class="control-item">

        <h3>
            Primer enjuague
        </h3>

        <div class="estado-botones">

            <button
                class="estado-btn"
                id="garrafon-enjuague1-realizado"
                onclick="seleccionarEnjuagueGarrafones(
                    1,
                    'Realizado'
                )"
            >
                ✓ Realizado
            </button>

            <button
                class="estado-btn"
                id="garrafon-enjuague1-no-realizado"
                onclick="seleccionarEnjuagueGarrafones(
                    1,
                    'No realizado'
                )"
            >
                ✕ No realizado
            </button>

        </div>

    </div>


    <!-- SEGUNDO ENJUAGUE -->

    <div class="control-item">

        <h3>
            Segundo enjuague
        </h3>

        <div class="estado-botones">

            <button
                class="estado-btn"
                id="garrafon-enjuague2-realizado"
                onclick="seleccionarEnjuagueGarrafones(
                    2,
                    'Realizado'
                )"
            >
                ✓ Realizado
            </button>

            <button
                class="estado-btn"
                id="garrafon-enjuague2-no-realizado"
                onclick="seleccionarEnjuagueGarrafones(
                    2,
                    'No realizado'
                )"
            >
                ✕ No realizado
            </button>

        </div>

    </div>


    <!-- INSPECCIÓN -->

    <div class="control-item">

        <h3>
            Inspección final del garrafón
        </h3>

        <div class="estado-botones">

            <button
                class="estado-btn"
                id="garrafon-inspeccion-conforme"
                onclick="seleccionarInspeccionGarrafones(
                    'Conforme'
                )"
            >
                ✓ Conforme
            </button>

            <button
                class="estado-btn"
                id="garrafon-inspeccion-no-conforme"
                onclick="seleccionarInspeccionGarrafones(
                    'No conforme'
                )"
            >
                ✕ No conforme
            </button>

        </div>

    </div>


    <!-- TIEMPOS -->

    <div class="control-item">

        <h3>
            Registro del tiempo de preparación
        </h3>

        <div class="horas-tanque">

            <div class="hora-bloque">

                <strong>
                    Hora de inicio
                </strong>

                <div
                    id="hora-inicio-garrafones"
                    class="hora-registrada"
                >
                    No registrada
                </div>

                <button
                    class="btn-secundario"
                    onclick="registrarHoraInicioGarrafones()"
                >
                    Registrar inicio
                </button>

            </div>


            <div class="hora-bloque">

                <strong>
                    Hora final
                </strong>

                <div
                    id="hora-final-garrafones"
                    class="hora-registrada"
                >
                    No registrada
                </div>

                <button
                    class="btn-secundario"
                    onclick="registrarHoraFinalGarrafones()"
                >
                    Registrar final
                </button>

            </div>

        </div>

    </div>


    <!-- OBSERVACIONES -->

    <div class="control-item">

        <h3>
            Observaciones
        </h3>

        <textarea
            id="observaciones-garrafones"
            rows="4"
            placeholder="Escriba aquí alguna observación..."
        ></textarea>

    </div>


    <!-- GUARDAR -->

    <button
        class="btn-principal btn-guardar"
        onclick="guardarPreparacionGarrafones()"
    >
        GUARDAR PREPARACIÓN
    </button>

</section>

<!-- =====================================================
     REGISTRO DE LLENADO
     ===================================================== -->

<section
    class="panel oculto"
    id="panel-llenado"
>

    <div class="cabecera-modulo">

        <div>

            <h2>
                Registro de llenado
            </h2>

            <p
                id="informacion-lote-llenado"
                class="texto-ayuda"
            ></p>

        </div>

        <button
            class="btn-secundario"
            onclick="cerrarRegistroLlenado()"
        >
            Volver
        </button>

    </div>


    <!-- TIPO DE ENVASE -->

    <div class="control-item">

        <h3>
            Tipo de envase
        </h3>

        <div class="estado-botones">

