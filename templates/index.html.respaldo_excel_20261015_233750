/* =========================================================
   FORMATO DE HORA
   ========================================================= */


function formatoHora(
    fecha
) {

    return fecha
        .toLocaleTimeString(
            "es-CO",
            {
                hour: "2-digit",
                minute: "2-digit",
                second: "2-digit",
                hour12: false
            }
        );

}



