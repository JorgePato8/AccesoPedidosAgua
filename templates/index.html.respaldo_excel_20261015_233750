/* =========================================================
   GUARDAR PREPARACIÓN
   ========================================================= */


async function guardarPreparacionGarrafones() {

    if (!loteActivoId) {

        alert(
            "No existe un lote activo."
        );

        return;
    }


    const camposCompletos =

        preparacionGarrafones
            .cantidad_garrafones > 0 &&

        preparacionGarrafones.enjuague_1 !== null &&

        preparacionGarrafones.enjuague_2 !== null &&

        preparacionGarrafones.inspeccion_final !== null &&

        preparacionGarrafones.hora_inicio !== "" &&

        preparacionGarrafones.hora_final !== "";


    if (!camposCompletos) {

        alert(
            "Debe completar todos los campos de la preparación."
        );

        return;
    }


    const observaciones =
        document
        .getElementById(
            "observaciones-garrafones"
        )
        .value
        .trim();


    const datos = {

        cantidad_garrafones:
            preparacionGarrafones
                .cantidad_garrafones,

        enjuague_1:
            preparacionGarrafones.enjuague_1,

        enjuague_2:
            preparacionGarrafones.enjuague_2,

        inspeccion_final:
            preparacionGarrafones
                .inspeccion_final,

        hora_inicio:
            preparacionGarrafones.hora_inicio,

        hora_final:
            preparacionGarrafones.hora_final,

        observaciones:
            observaciones
    };


    const respuesta =
        await fetch(
            `/api/lotes/${loteActivoId}/garrafones`,
            {

                method: "POST",

                headers: {
                    "Content-Type":
                        "application/json"
                },

                body:
                    JSON.stringify(datos)
            }
        );


    const resultado =
        await respuesta.json();


    if (!respuesta.ok) {

        alert(
            resultado.detail ||
            "No se pudo guardar la preparación."
        );

        return;
    }


    alert(
        "Preparación de garrafones guardada correctamente."
    );


    preparacionGarrafones = {

        cantidad_garrafones: 1,

        enjuague_1: null,

        enjuague_2: null,

        inspeccion_final: null,

        hora_inicio: "",

        hora_final: ""
    };


    document
        .getElementById(
            "cantidad-garrafones"
        )
        .textContent =
            "1";


    document
        .getElementById(
            "observaciones-garrafones"
        )
        .value = "";


    document
        .querySelectorAll(
            "#panel-garrafones .estado-btn"
        )
        .forEach(
            boton =>
                boton.classList.remove(
                    "seleccionado"
                )
        );


    document
        .getElementById(
            "hora-inicio-garrafones"
        )
        .textContent =
            "No registrada";


    document
        .getElementById(
            "hora-final-garrafones"
        )
        .textContent =
            "No registrada";
}

