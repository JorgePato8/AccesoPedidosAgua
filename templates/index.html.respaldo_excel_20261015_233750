/* =========================================================
   LIMPIEZA Y DESINFECCIÓN
   ========================================================= */


function abrirLimpiezaDesinfeccion() {

    document
        .getElementById("menu-operacion")
        .classList
        .add("oculto");


    document
        .getElementById("panel-limpieza")
        .classList
        .remove("oculto");

}



/* =========================================================
   CERRAR MÓDULO
   ========================================================= */


function cerrarLimpiezaDesinfeccion() {

    document
        .getElementById("panel-limpieza")
        .classList
        .add("oculto");


    document
        .getElementById("menu-operacion")
        .classList
        .remove("oculto");

}




/* =========================================================
   HORA DE INICIO
   ========================================================= */


function registrarHoraInicioLimpieza() {

    const hora =
        formatoHora(
            new Date()
        );


    controlLimpieza.hora_inicio =
        hora;


    document
        .getElementById(
            "hora-inicio-limpieza"
        )
        .textContent =
            hora;

}



/* =========================================================
   HORA FINAL
   ========================================================= */


function registrarHoraFinalLimpieza() {

    if (
        !controlLimpieza.hora_inicio
    ) {

        alert(
            "Primero registre la hora de inicio."
        );

        return;

    }


    const hora =
        formatoHora(
            new Date()
        );


    controlLimpieza.hora_final =
        hora;


    document
        .getElementById(
            "hora-final-limpieza"
        )
        .textContent =
            hora;

}



/* =========================================================
   RESULTADO
   ========================================================= */


function seleccionarResultadoLimpieza(
    valor
) {

    controlLimpieza.resultado =
        valor;


    document
        .getElementById(
            "limpieza-conforme"
        )
        .classList
        .remove("seleccionado");


    document
        .getElementById(
            "limpieza-no-conforme"
        )
        .classList
        .remove("seleccionado");


    if (
        valor === "Conforme"
    ) {

        document
            .getElementById(
                "limpieza-conforme"
            )
            .classList
            .add("seleccionado");

    }

    else {

        document
            .getElementById(
                "limpieza-no-conforme"
            )
            .classList
            .add("seleccionado");

    }

}



/* =========================================================
   GUARDAR LIMPIEZA
   ========================================================= */


async function guardarLimpieza() {

    const operador =
        document
        .getElementById("operador")
        .value;


