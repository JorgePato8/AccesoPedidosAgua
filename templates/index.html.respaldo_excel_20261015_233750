   DETENER CRONÓMETRO
   ========================================================= */


function detenerCronometro() {

    if (intervaloCronometro !== null) {

        clearInterval(
            intervaloCronometro
        );

        intervaloCronometro =
            null;
    }


    inicioCronometro =
        null;
}



