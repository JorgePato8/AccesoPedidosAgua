    tipo,
    valor
) {


    if (tipo === "inicial") {

        controlTanque.estado_inicial =
            valor;

    }
    else {

        controlTanque.estado_final =
            valor;

    }


    const niveles = [
        "Vacío",
        "Bajo",
        "Medio",
        "Alto",
        "Lleno"
    ];


    niveles.forEach(
        nivel => {

            const boton =
                document.getElementById(
                    "tanque-" +
                    tipo +
                    "-" +
                    nivel
                        .toLowerCase()
                        .replace("í", "i")
                );


            if (boton) {

                boton.classList.remove(
                    "seleccionado"
                );

            }

        }
    );


    const idBoton =
        "tanque-" +
        tipo +
        "-" +
        valor
            .toLowerCase()
            .replace("í", "i");


    const botonSeleccionado =
        document.getElementById(
            idBoton
        );


    if (botonSeleccionado) {

        botonSeleccionado.classList.add(
            "seleccionado"
        );

    }

