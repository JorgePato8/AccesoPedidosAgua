   ========================================================= */


async function guardarControlCalidad() {

    if (!loteActivoId) {
        alert("No existe un lote activo.");
        return;
    }

    if (
        controlCalidad.momento_muestreo === null ||
        controlCalidad.momento_muestreo === ""
    ) {
        alert(
            "Debe seleccionar el momento del muestreo respecto al lavado del tanque."
        );
        return;
    }

    if (
        controlCalidad.cumplimiento === null ||
        controlCalidad.cumplimiento === ""
    ) {
        alert(
            "Debe seleccionar el cumplimiento del control."
        );
        return;
    }

    const phTexto = document
        .getElementById("calidad-ph")
        .value
        .trim();

    const observaciones = document
        .getElementById("observaciones-calidad")
        .value
        .trim();

    const ph = phTexto === "" ? null : Number(phTexto);

    if (
        ph !== null &&
        (
            !Number.isFinite(ph) ||
            ph < 0 ||
            ph > 14
        )
    ) {
        alert("El pH debe ser un número entre 0 y 14.");
        return;
    }

    const datos = {
        ph: ph,

        momento_muestreo:
            controlCalidad.momento_muestreo,

        cumplimiento:
            controlCalidad.cumplimiento,

        observaciones: observaciones
    };

    const respuesta = await fetch(
        `/api/lotes/${loteActivoId}/calidad`,
        {
            method: "POST",

            headers: {
                "Content-Type": "application/json"
            },

            body: JSON.stringify(datos)
        }
    );

    const resultado = await respuesta.json();

    if (!respuesta.ok) {
        alert(
            resultado.detail ||
            "No se pudo guardar el control de calidad."
        );
        return;
    }

    alert(
        "Control de calidad guardado correctamente."
    );

    controlCalidad = {
        momento_muestreo: null,
        cumplimiento: null
    };

    document.getElementById("calidad-ph").value = "";

    document.getElementById(
        "observaciones-calidad"
    ).value = "";

    document
        .querySelectorAll(
            "#panel-calidad .seleccionado"
        )
        .forEach(elemento => {
            elemento.classList.remove("seleccionado");
        });

}


