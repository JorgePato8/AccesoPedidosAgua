/* =========================================================
   MOSTRAR RESULTADO EN PANTALLA
   ========================================================= */


function actualizarResultadoVisual() {


    const valores =
        Object.values(
            estadosTratamiento
        );


    const completos =
        valores.every(
            valor => valor !== null
        );


    const resultado =
        document.getElementById(
            "resultado-tratamiento"
        );


    if (!completos) {

        resultado.className =
            "resultado-tratamiento";


        resultado.textContent =
            "Seleccione el estado de todas las etapas.";

        return;

    }


    const todoConforme =
        valores.every(
            valor => valor === "Conforme"
        );


    if (todoConforme) {

        resultado.className =
            "resultado-tratamiento resultado-ok";


        resultado.textContent =
            "Resultado general: CONFORME";

    }
    else {

        resultado.className =
            "resultado-tratamiento resultado-no";


        resultado.textContent =
            "Resultado general: NO CONFORME";

    }


}



