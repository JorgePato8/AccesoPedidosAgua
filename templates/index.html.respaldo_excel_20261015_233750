/* =========================================================
   MANTENIMIENTO: VARIABLES Y UTILIDADES
   ========================================================= */

let mantenimientoInicioMillis = null;

let mantenimientoHoraInicio = "";

let mantenimientoHoraFinal = "";

let intervaloMantenimiento = null;


function fechaActualLocalMantenimiento() {

    const fecha = new Date();

    const anio = fecha.getFullYear();

    const mes = String(
        fecha.getMonth() + 1
    ).padStart(2, "0");

    const dia = String(
        fecha.getDate()
    ).padStart(2, "0");

    return `${anio}-${mes}-${dia}`;
}


function formatearHoraMantenimiento(fecha) {

    const horas = String(
        fecha.getHours()
    ).padStart(2, "0");

    const minutos = String(
        fecha.getMinutes()
    ).padStart(2, "0");

    const segundos = String(
        fecha.getSeconds()
    ).padStart(2, "0");

    return `${horas}:${minutos}:${segundos}`;
}


function formatearDuracionMantenimiento(segundos) {

    const total = Math.max(
        0,
        Math.floor(Number(segundos) || 0)
    );

    const horas = String(
        Math.floor(total / 3600)
    ).padStart(2, "0");

    const minutos = String(
        Math.floor((total % 3600) / 60)
    ).padStart(2, "0");

    const segundosRestantes = String(
        total % 60
    ).padStart(2, "0");

    return (
        `${horas}:${minutos}:` +
        `${segundosRestantes}`
    );
}


function escaparHTMLMantenimiento(valor) {

    return String(valor ?? "").replace(
        /[&<>"']/g,
        caracter => ({
            "&": "&amp;",
            "<": "&lt;",
            ">": "&gt;",
            '"': "&quot;",
            "'": "&#39;"
        })[caracter]
    );
}


/* =========================================================
   ABRIR Y CERRAR EL MÓDULO
   ========================================================= */


function abrirMantenimiento() {

    console.log(
        "[Mantenimiento] Se recibió el clic del botón."
    );

    const menu = document.getElementById(
        "menu-operacion"
    );

    const panel = document.getElementById(
        "panel-mantenimiento"
    );

    const campoFecha = document.getElementById(
        "mantenimiento-fecha"
    );

    if (!menu || !panel || !campoFecha) {

        console.error(
            "[Mantenimiento] No se encontró el menú, " +
            "el panel o el campo de fecha.",
            {
                menuEncontrado: Boolean(menu),
                panelEncontrado: Boolean(panel),
                fechaEncontrada: Boolean(campoFecha)
            }
        );

        alert(
            "No se pudo abrir Mantenimiento. " +
            "Revise la consola del navegador."
        );

        return;
    }

    menu.classList.add("oculto");

    panel.classList.remove("oculto");

    if (!campoFecha.value) {

        campoFecha.value =
            fechaActualLocalMantenimiento();

    }

    cargarMantenimientos();

}


function cerrarMantenimiento() {

    if (
        mantenimientoInicioMillis !== null &&
        mantenimientoHoraFinal === ""
    ) {

        alert(
            "Hay una intervención iniciada sin hora de finalización. " +
            "Registre la finalización antes de salir."
        );

        return;
    }

    document
        .getElementById("panel-mantenimiento")
        .classList
        .add("oculto");

    document
        .getElementById("menu-operacion")
        .classList
        .remove("oculto");

}


/* =========================================================
   REGISTRO DEL TIEMPO DE INTERVENCIÓN
   ========================================================= */


function iniciarTiempoMantenimiento() {

    if (mantenimientoInicioMillis !== null) {

        alert(
            "Ya hay una intervención con el tiempo iniciado."
        );

        return;
    }

    const ahora = new Date();

    mantenimientoInicioMillis = ahora.getTime();

    mantenimientoHoraInicio =
        formatearHoraMantenimiento(ahora);

    mantenimientoHoraFinal = "";

    document.getElementById(
        "hora-inicio-mantenimiento"
    ).textContent = mantenimientoHoraInicio;

    document.getElementById(
        "hora-final-mantenimiento"
    ).textContent = "No registrada";

    document.getElementById(
        "cronometro-mantenimiento"
    ).textContent = "00:00:00";

    document.getElementById(
        "btn-inicio-mantenimiento"
    ).disabled = true;

    document.getElementById(
        "btn-final-mantenimiento"
    ).disabled = false;

    if (intervaloMantenimiento !== null) {

        clearInterval(intervaloMantenimiento);

    }

    intervaloMantenimiento = setInterval(
        actualizarCronometroMantenimiento,
        1000
    );

}


function actualizarCronometroMantenimiento() {

    if (mantenimientoInicioMillis === null) {
        return;
    }

    const segundos = Math.floor(
        (Date.now() - mantenimientoInicioMillis) / 1000
    );

    document.getElementById(
        "cronometro-mantenimiento"
    ).textContent =
        formatearDuracionMantenimiento(segundos);

}


function finalizarTiempoMantenimiento() {

    if (mantenimientoInicioMillis === null) {

        alert(
            "Primero debe registrar la hora de inicio."
        );

        return;
    }

    if (mantenimientoHoraFinal !== "") {

        alert(
            "La hora de finalización ya fue registrada."
        );

        return;
    }

    const ahora = new Date();

    mantenimientoHoraFinal =
        formatearHoraMantenimiento(ahora);

    document.getElementById(
        "hora-final-mantenimiento"
    ).textContent = mantenimientoHoraFinal;

    if (intervaloMantenimiento !== null) {

        clearInterval(intervaloMantenimiento);

        intervaloMantenimiento = null;

    }

    actualizarCronometroMantenimiento();

    document.getElementById(
        "btn-final-mantenimiento"
    ).disabled = true;

}


function reiniciarTiempoMantenimiento() {

    if (intervaloMantenimiento !== null) {

        clearInterval(intervaloMantenimiento);

        intervaloMantenimiento = null;

    }

    mantenimientoInicioMillis = null;

    mantenimientoHoraInicio = "";

    mantenimientoHoraFinal = "";

    document.getElementById(
        "hora-inicio-mantenimiento"
    ).textContent = "No registrada";

    document.getElementById(
        "hora-final-mantenimiento"
    ).textContent = "No registrada";

    document.getElementById(
        "cronometro-mantenimiento"
    ).textContent = "00:00:00";

    document.getElementById(
        "btn-inicio-mantenimiento"
    ).disabled = false;

    document.getElementById(
        "btn-final-mantenimiento"
    ).disabled = true;

}


/* =========================================================
   GUARDAR MANTENIMIENTO
   ========================================================= */


async function guardarMantenimiento() {

    const operador = document
        .getElementById("operador")
        .value;

    const fecha = document
        .getElementById("mantenimiento-fecha")
        .value;

    const equipoSeleccionado = document
        .getElementById("mantenimiento-equipo")
        .value;

    const equipoDetalle = document
        .getElementById("mantenimiento-equipo-detalle")
        .value
        .trim();

    const tipo = document
        .getElementById("mantenimiento-tipo")
        .value;

    const descripcion = document
        .getElementById("mantenimiento-descripcion")
        .value
        .trim();

    const materiales = document
        .getElementById("mantenimiento-materiales")
        .value
        .trim();

    const estadoFinal = document
        .getElementById("mantenimiento-estado-final")
        .value;

    const fechaProximo = document
        .getElementById("mantenimiento-proximo")
        .value;

    const observaciones = document
        .getElementById("mantenimiento-observaciones")
        .value
        .trim();


    if (!operador) {

        alert(
            "Debe seleccionar el operador responsable."
        );

        return;
    }

    if (!fecha) {

        alert(
            "Debe registrar la fecha del mantenimiento."
        );

        return;
    }

    if (!equipoSeleccionado) {

        alert(
            "Debe seleccionar el equipo intervenido."
        );

        return;
    }

    if (
        equipoSeleccionado === "Otro" &&
        equipoDetalle === ""
    ) {

        alert(
            "Especifique el nombre del equipo seleccionado como Otro."
        );

        return;
    }

    if (!tipo) {

        alert(
            "Debe seleccionar el tipo de intervención."
        );

        return;
    }

    if (!descripcion) {

        alert(
            "Debe describir el trabajo realizado."
        );

        return;
    }

    if (
        mantenimientoHoraInicio === "" ||
        mantenimientoHoraFinal === ""
    ) {

        alert(
            "Debe registrar la hora de inicio y la hora de finalización."
        );

        return;
    }

    if (!estadoFinal) {

        alert(
            "Debe seleccionar el estado final del equipo."
        );

        return;
    }


    const equipo =
        equipoSeleccionado === "Otro"
            ? `Otro: ${equipoDetalle}`
            : equipoSeleccionado;


    const datos = {

        operador_id: Number(operador),

        fecha_mantenimiento: fecha,

        equipo: equipo,

        tipo_mantenimiento: tipo,

        descripcion: descripcion,

        repuestos_materiales: materiales,

        hora_inicio: mantenimientoHoraInicio,

        hora_final: mantenimientoHoraFinal,

        estado_final: estadoFinal,

        fecha_proximo_mantenimiento:
            fechaProximo || null,

        observaciones: observaciones

    };


    try {

        const respuesta = await fetch(
            "/api/mantenimientos",
            {

                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify(datos)

            }
        );

        const resultado = await respuesta.json();

        if (!respuesta.ok) {

            alert(
                resultado.detail ||
                "No se pudo guardar el mantenimiento."
            );

            return;
        }

        alert(
            "Mantenimiento guardado correctamente.\n\n" +
            "Duración registrada: " +
            formatearDuracionMantenimiento(
                resultado.tiempo_segundos
            )
        );


        document.getElementById(
            "mantenimiento-fecha"
        ).value = fechaActualLocalMantenimiento();

        document.getElementById(
            "mantenimiento-equipo"
        ).value = "";

        document.getElementById(
            "mantenimiento-equipo-detalle"
        ).value = "";

        document.getElementById(
            "mantenimiento-tipo"
        ).value = "";

        document.getElementById(
            "mantenimiento-descripcion"
        ).value = "";

        document.getElementById(
            "mantenimiento-materiales"
        ).value = "";

        document.getElementById(
            "mantenimiento-estado-final"
        ).value = "";

        document.getElementById(
            "mantenimiento-proximo"
        ).value = "";

        document.getElementById(
            "mantenimiento-observaciones"
        ).value = "";


        reiniciarTiempoMantenimiento();

        await cargarMantenimientos();

    } catch (error) {

        console.error(
            "Error al guardar el mantenimiento:",
            error
        );

        alert(
            "No fue posible comunicarse con el servidor. " +
            "Compruebe que la aplicación esté funcionando."
        );

    }

}


/* =========================================================
   CONSULTAR HISTORIAL
   ========================================================= */


async function cargarMantenimientos() {

    const cuerpo = document.getElementById(
        "filas-mantenimientos"
    );

    cuerpo.innerHTML = `
        <tr>
            <td colspan="9">
                Cargando historial...
            </td>
        </tr>
    `;

    try {

        const respuesta = await fetch(
            "/api/mantenimientos"
        );

        const filas = await respuesta.json();

        if (!respuesta.ok) {

            throw new Error(
                filas.detail ||
                "No se pudo consultar el historial."
            );

        }

        if (!Array.isArray(filas) || filas.length === 0) {

            cuerpo.innerHTML = `
                <tr>
                    <td colspan="9">
                        Todavía no hay mantenimientos registrados.
                    </td>
                </tr>
            `;

            return;
        }


        cuerpo.innerHTML = filas.map(fila => {

            const clasesEstado = {

                "Vencido": "programacion-vencido",

                "Próximo": "programacion-proximo",

                "Programado": "programacion-programado",

                "Sin programar": "programacion-sin-programar"

            };

            const claseEstado =
                clasesEstado[fila.estado_programacion] ||
                "programacion-sin-programar";

            const duracion =
                formatearDuracionMantenimiento(
                    fila.tiempo_segundos
                );

            const proximo =
                fila.fecha_proximo_mantenimiento ||
                "No registrada";

            let detalle = escaparHTMLMantenimiento(
                fila.descripcion
            );

            if (fila.repuestos_materiales) {

                detalle +=
                    "<br><strong>Materiales:</strong> " +
                    escaparHTMLMantenimiento(
                        fila.repuestos_materiales
                    );

            }

            if (fila.observaciones) {

                detalle +=
                    "<br><strong>Observaciones:</strong> " +
                    escaparHTMLMantenimiento(
                        fila.observaciones
                    );

            }

            return `
                <tr>

                    <td>
                        ${escaparHTMLMantenimiento(
                            fila.fecha_mantenimiento
                        )}
                    </td>

                    <td>
                        ${escaparHTMLMantenimiento(
                            fila.equipo
                        )}
                    </td>

                    <td>
                        ${escaparHTMLMantenimiento(
                            fila.tipo_mantenimiento
                        )}
                    </td>

                    <td>
                        ${escaparHTMLMantenimiento(
                            fila.operador_nombre
                        )}
                    </td>

                    <td>
                        ${duracion}
                    </td>

                    <td>
                        ${escaparHTMLMantenimiento(
                            fila.estado_final
                        )}
                    </td>

                    <td>
                        ${escaparHTMLMantenimiento(
                            proximo
                        )}
                    </td>

                    <td>
                        <span class="estado-programacion ${claseEstado}">
                            ${escaparHTMLMantenimiento(
                                fila.estado_programacion
                            )}
                        </span>
                    </td>

                    <td>
                        ${detalle}
                    </td>

                </tr>
            `;

        }).join("");

    } catch (error) {

        console.error(
            "Error al cargar mantenimientos:",
            error
        );

        cuerpo.innerHTML = `
            <tr>
                <td colspan="9">
                    No se pudo cargar el historial.
                    Revise la conexión con el servidor.
                </td>
            </tr>
        `;

    }

}


/* =========================================================
   PEDIDOS: ESTADOS DISPONIBLES
   ========================================================= */

const estadosPedido = [
    "Pendiente",
    "En preparación",
    "Listo para entregar",
    "Entregado",
    "Cancelado"
];


/* =========================================================
   REGISTRAR PEDIDO
   ========================================================= */

async function registrarPedido() {

    const oficina = document
        .getElementById("pedido-oficina")
        .value
        .trim();

    const solicitante = document
        .getElementById("pedido-solicitante")
        .value
        .trim();

    const garrafonesTexto = document
        .getElementById("pedido-garrafones")
        .value
        .trim();

    const botellasTexto = document
        .getElementById("pedido-botellas")
        .value
        .trim();

    const observacion = document
        .getElementById("pedido-observacion")
        .value
        .trim();

    const mensaje = document.getElementById(
        "mensaje-pedido"
    );


    if (!oficina || !solicitante) {

        alert(
            "Debe indicar la oficina y el nombre del solicitante."
        );

        return;
    }

    if (
        garrafonesTexto === "" ||
        botellasTexto === ""
    ) {

        alert(
            "Debe indicar las cantidades solicitadas."
        );

        return;
    }

    const garrafones = Number(garrafonesTexto);
    const botellas = Number(botellasTexto);

    if (
        !Number.isSafeInteger(garrafones) ||
        !Number.isSafeInteger(botellas) ||
        garrafones < 0 ||
        botellas < 0
    ) {

        alert(
            "Las cantidades deben ser números enteros iguales o mayores que cero."
        );

        return;
    }

    if (garrafones === 0 && botellas === 0) {

        alert(
            "Debe solicitar al menos un garrafón o una botella."
        );

        return;
    }


    const datos = {
        oficina: oficina,
        solicitante: solicitante,
        garrafones: garrafones,
        botellas: botellas,
        observacion: observacion
    };


    try {

        const respuesta = await fetch(
            "/api/pedidos",
            {
                method: "POST",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify(datos)
            }
        );

        const resultado = await respuesta.json();

        if (!respuesta.ok) {

            alert(
                resultado.detail ||
                "No se pudo registrar el pedido."
            );

            return;
        }


        mensaje.textContent =
            "Pedido #" + resultado.id +
            " registrado correctamente. Estado: Pendiente.";

        document.getElementById(
            "pedido-oficina"
        ).value = "";

        document.getElementById(
            "pedido-solicitante"
        ).value = "";

        document.getElementById(
            "pedido-garrafones"
        ).value = "0";

        document.getElementById(
            "pedido-botellas"
        ).value = "0";

        document.getElementById(
            "pedido-observacion"
        ).value = "";


        await cargarPedidos();

    } catch (error) {

        console.error(
            "Error al registrar el pedido:",
            error
        );

        alert(
            "No fue posible comunicarse con el servidor."
        );

    }

}


/* =========================================================
   CARGAR HISTORIAL DE PEDIDOS
   ========================================================= */

async function cargarPedidos() {

    const cuerpo = document.getElementById(
        "filas-pedidos"
    );

    if (!cuerpo) {
        return;
    }

    cuerpo.innerHTML = `
        <tr>
            <td colspan="8">
                Cargando pedidos...
            </td>
        </tr>
    `;

    try {

        const respuesta = await fetch(
            "/api/pedidos"
        );

        const pedidos = await respuesta.json();

        if (!respuesta.ok) {

            throw new Error(
                pedidos.detail ||
                "No se pudo consultar el historial."
            );

        }

        if (
            !Array.isArray(pedidos) ||
            pedidos.length === 0
        ) {

            cuerpo.innerHTML = `
                <tr>
                    <td colspan="8">
                        Todavía no hay pedidos registrados.
                    </td>
                </tr>
            `;

            return;
        }


        cuerpo.innerHTML = pedidos.map(pedido => {

            const id = Number(pedido.id);

            const fecha =
                escaparHTMLMantenimiento(
                    pedido.fecha_solicitud
                );

            const oficina =
                escaparHTMLMantenimiento(
                    pedido.oficina
                );

            const solicitante =
                escaparHTMLMantenimiento(
                    pedido.solicitante
                );

            const observacion =
                escaparHTMLMantenimiento(
                    pedido.observacion || "—"
                );

            const estado =
                escaparHTMLMantenimiento(
                    pedido.estado
                );

            const opciones = estadosPedido.map(
                opcion => `
                    <option
                        value="${opcion}"
                        ${opcion === pedido.estado ? "selected" : ""}
                    >
                        ${opcion}
                    </option>
                `
            ).join("");


            return `
                <tr>

                    <td>${fecha}</td>

                    <td>${oficina}</td>

                    <td>${solicitante}</td>

                    <td>${Number(pedido.garrafones)}</td>

                    <td>${Number(pedido.botellas)}</td>

                    <td>${observacion}</td>

                    <td>${estado}</td>

                    <td>
                        <div class="acciones-pedido">

                            <select
                                id="estado-pedido-${id}"
                                aria-label="Nuevo estado del pedido ${id}"
                            >
                                ${opciones}
                            </select>

                            <button
                                type="button"
                                class="btn-secundario"
                                onclick="actualizarEstadoPedido(${id})"
                            >
                                Guardar estado
                            </button>

                        </div>
                    </td>

                </tr>
            `;

        }).join("");

    } catch (error) {

        console.error(
            "Error al cargar pedidos:",
            error
        );

        cuerpo.innerHTML = `
            <tr>
                <td colspan="8">
                    No se pudo cargar el historial.
                    Compruebe el servidor y vuelva a intentarlo.
                </td>
            </tr>
        `;

    }

}


/* =========================================================
   ACTUALIZAR ESTADO DE PEDIDO
   ========================================================= */

async function actualizarEstadoPedido(pedidoId) {

    const selector = document.getElementById(
        "estado-pedido-" + pedidoId
    );

    if (!selector) {

        alert(
            "No se encontró el selector de estado del pedido."
        );

        return;
    }

    const estado = selector.value;

    if (!estadosPedido.includes(estado)) {

        alert(
            "El estado seleccionado no es válido."
        );

        return;
    }


    try {

        const respuesta = await fetch(
            `/api/pedidos/${pedidoId}/estado`,
            {
                method: "PATCH",

                headers: {
                    "Content-Type": "application/json"
                },

                body: JSON.stringify({
                    estado: estado
                })
            }
        );

        const resultado = await respuesta.json();

        if (!respuesta.ok) {

            alert(
                resultado.detail ||
                "No se pudo actualizar el estado del pedido."
            );

            return;
        }

        alert(
            "Pedido #" + pedidoId +
            " actualizado a: " + resultado.estado
        );

        await cargarPedidos();

    } catch (error) {

        console.error(
            "Error al actualizar el pedido:",
            error
        );

        alert(
            "No fue posible comunicarse con el servidor."
        );

    }

}

/* =========================================================
   VERIFICAR SESIÓN DEL OPERADOR
   ========================================================= */

