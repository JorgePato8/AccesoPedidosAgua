/* =========================================================
   ACTUALIZAR CRONÓMETRO
   ========================================================= */


function actualizarCronometro() {

    if (inicioCronometro === null) {

        return;

    }


    const ahora =
        Date.now();


    const segundos =
        Math.floor(
            (ahora - inicioCronometro)
            / 1000
        );


    const minutos =
        Math.floor(
            segundos / 60
        );


    const segundosRestantes =
        segundos % 60;


    const textoMinutos =
        String(minutos)
        .padStart(2, "0");


    const textoSegundos =
        String(segundosRestantes)
        .padStart(2, "0");


    document
        .getElementById(
            "cronometro-llenado"
        )
        .textContent =
            `${textoMinutos}:${textoSegundos}`;

}



